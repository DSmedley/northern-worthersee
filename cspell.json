{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/packages/cspell-types/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "files": ["content/**/*.md"],
  "ignorePaths": ["node_modules", "public", "resources", "themes"],
  "ignoreRegExpList": [
    "\\{\\{[<%][^}]*[>%]\\}\\}"
  ],
  "words": [
    "NoWo",
    "Wörthersee",
    "Worthersee",
    "Frankenmuth",
    "northernworthersee",
    "VAG",
    "Kern",
    "featureimage",
    "showBreadcrumbs",
    "Cass",
  ]
}
