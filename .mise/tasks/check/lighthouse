#!/usr/bin/env bash
#MISE description="Run Lighthouse checks (performance & accessibility budgets) across all pages using Unlighthouse"
#MISE alias="check:lh"
set -euo pipefail

CHROME=$(find ~/.cache/ms-playwright -name "chrome" -type f 2>/dev/null | head -1)
if [ -z "$CHROME" ]; then
  echo "ERROR: Playwright browsers not installed. Run: mise run sync:browsers" >&2
  exit 1
fi
export PUPPETEER_EXECUTABLE_PATH="$CHROME"
hugo server --port 1314 --disableFastRender > /dev/null 2>&1 &
SERVER_PID=$!
trap 'kill $SERVER_PID 2>/dev/null' EXIT
# A cold image cache makes startup slow (hugo regenerates every gallery
# thumbnail), so allow up to 5 minutes — but fail fast if the server dies.
tries=0
until curl -sf http://localhost:1314 > /dev/null; do
  if ! kill -0 "$SERVER_PID" 2>/dev/null; then
    echo "ERROR: hugo server exited before becoming ready" >&2
    exit 1
  fi
  tries=$((tries + 1))
  if [ "$tries" -ge 600 ]; then
    echo "ERROR: hugo server did not become ready within 5 minutes" >&2
    exit 1
  fi
  sleep 0.5
done
npx unlighthouse-ci --site http://localhost:1314 --disable-robots-txt
