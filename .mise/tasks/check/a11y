#!/usr/bin/env bash
#MISE description="Check accessibility across all pages using pa11y-ci"
set -euo pipefail

CHROME=$(find ~/.cache/ms-playwright -name "chrome" -type f 2>/dev/null | head -1)
if [ -z "$CHROME" ]; then
  echo "ERROR: Playwright browsers not installed. Run: mise run sync:browsers" >&2
  exit 1
fi
export PUPPETEER_EXECUTABLE_PATH="$CHROME"
hugo server --port 1314 --disableFastRender > /dev/null 2>&1 &
SERVER_PID=$!
trap 'kill $SERVER_PID 2>/dev/null' EXIT
until curl -sf http://localhost:1314 > /dev/null; do sleep 0.5; done
npx pa11y-ci --sitemap http://localhost:1314/sitemap.xml
