{{ $shouldAddCheckBackPage := true }}
{{ $eventDate := partial "event-date" . }}
{{ $eventYear := $eventDate.Format "2006" }}
{{ $event := site.Data.event }}
{{ range $objectIndex, $object := sort (readDir "assets/gallery") "Name" "desc" }}
  {{ if $object.IsDir }}
    {{ $dirName := $object.Name }}
    {{ $shouldAddPage := false }}
    {{ $featureImage := "" }}

    {{ if eq $eventYear $dirName }}
      {{ $shouldAddCheckBackPage = false }}
    {{ end }}

    {{ $value := printf "> Have photos from this event? Share them at {{< email email=mailto:%s text=%s >}} we'd love to feature your shots.\n\n" $event.email $event.email }}
    {{ $value = print $value "{{< photoswipe >}}" }}

    {{ range $fileIndex, $file := resources.Match (printf "gallery/%s/**" $dirName) }}
      {{ if eq $file.MediaType.MainType "image" }}
        {{ if eq $fileIndex 1 }}
          {{ $featureImage = $file.Name }}
        {{ end }}
        {{ if strings.HasPrefix (path.Base $file.Name) "feature" }}
          {{ $featureImage = $file.Name }}
        {{ end }}
        {{ $shouldAddPage = true }}
        {{ $image := printf `{{< photo src="%s" alt="NoWo %s" >}}` $file.RelPermalink $dirName }}
        {{ $value = print $value $image }}
      {{ end }}
    {{ end }}

    {{ $value = print $value "{{< /photoswipe >}}" }}

    {{ $content := dict
      "mediaType" "text/markdown"
      "value" $value
    }}
    {{ $title := printf "NoWo %s Gallery" $dirName }}
    {{ $description := printf "Photos from the Northern Wörthersee %s car show in Frankenmuth, MI." $dirName }}
    {{ $params := dict
      "featureimage" $featureImage
    }}
    {{ $page := dict
      "content" $content
      "kind" "page"
      "path" $dirName
      "title" $title
      "description" $description
      "weight" (mul (add $objectIndex 1) 10)
      "params" $params
    }}
    {{ if $shouldAddPage }}
      {{ $.AddPage $page }}
    {{ end }}

  {{ end }}
{{ end }}
{{ if $shouldAddCheckBackPage }}

  {{ $cbValue := printf "## Gallery Coming %s\n\n" ($eventDate.Format "January 2, 2006") }}
  {{ $cbValue = print $cbValue (printf "Photos from **NoWo %s** will be posted here after the event. Check back after %s!\n\n" $eventYear ($eventDate.Format "January 2")) }}
  {{ $cbValue = print $cbValue (printf "In the meantime, [browse past years' galleries](/gallery/) or [register your vehicle](%s) for the %s show.\n\n" $event.registrationUrl $eventYear) }}
  {{ $cbValue = print $cbValue "---\n\n" }}
  {{ $cbValue = print $cbValue "### Share Your Photos\n\n" }}
  {{ $cbValue = print $cbValue (printf "Attending NoWo %s? We'd love to feature your shots in the official gallery.\n\n" $eventYear) }}
  {{ $cbValue = print $cbValue (printf "Send your photos to {{< email email=mailto:%s text=%s >}}\n\n" $event.email $event.email) }}
  {{ $cbValue = print $cbValue "{{< follow >}}" }}

  {{ $.AddPage (dict
    "content" (dict
      "mediaType" "text/markdown"
      "value" $cbValue)
    "path"  $eventYear
    "kind"  "page"
    "title" (printf "NoWo %s Gallery" $eventYear)
    "description" (printf "Photos from the Northern Wörthersee %s car show in Frankenmuth, MI. Coming soon after the event." $eventYear)
    "weight" 1
    "params" (dict
      "featureimage" "img/event.jpg"
    )
  ) }}
{{ end }}
